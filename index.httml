<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">




<link rel="manifest" href="manifest.json">




  <title>Kul Scientific Calculator</title>

  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;

      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;

      background: linear-gradient(135deg, #dfe9f3, #ffffff);

      font-family: Arial, sans-serif;
    }

    h1 {
      margin: 0 0 20px 0;
      font-size: 27px;
      color: #222;
      text-align: center;
      text-shadow: 1px 2px 3px #aaa;
    }

    .calculator {
      width: 94%;
      max-width: 380px;

      padding: 20px;

      background: linear-gradient(145deg, #222, #444);

      border: 4px solid #111;
      border-radius: 30px;

      box-shadow:
        0 12px 25px rgba(0,0,0,0.4),
        inset 0 2px 4px rgba(255,255,255,0.2);
    }

    #display {
      display: block;

      width: 100%;
      height: 70px;

      margin: 0 0 15px 0;
      padding: 10px 12px;

      border: 4px solid #111;
      border-radius: 12px;

      background: #dff5d8;
      color: #111;

      font-size: 29px;
      font-weight: bold;

      text-align: right;

      box-shadow:
        inset 0 3px 8px rgba(0,0,0,0.3);
    }

    .buttons {
      width: 100%;

      display: grid;

      grid-template-columns: repeat(4, 1fr);

      gap: 9px;
    }

    button {
      width: 100%;
      height: 58px;

      border: 2px solid #111;
      border-radius: 11px;

      background: linear-gradient(145deg, #f5f5f5, #cfcfcf);

      color: #111;

      font-size: 23px;
      font-weight: bold;

      box-shadow:
        0 4px 6px rgba(0,0,0,0.35);

      cursor: pointer;

      transition: 0.1s;
    }

    /* Operators */
    .operator {
      background: linear-gradient(145deg, #ffb347, #ff8c00);
      color: white;
    }

    /* Function buttons */
    .function {
      background: linear-gradient(145deg, #8ec5fc, #4a90e2);
      color: white;
    }

    /* AC */
    .clear {
      background: linear-gradient(145deg, #ff6666, #cc0000);
      color: white;
    }

    /* Equal */
    .equal {
      background: linear-gradient(145deg, #66bb6a, #2e7d32);
      color: white;
    }

    button:active {
      transform: translateY(3px) scale(0.96);

      box-shadow:
        0 1px 2px rgba(0,0,0,0.3);
    }

    @media (max-width: 380px) {

      .calculator {
        width: 94%;
        padding: 15px;
      }

      #display {
        height: 65px;
        font-size: 26px;
      }

      button {
        height: 54px;
        font-size: 21px;
      }
    }

  </style>
</head>

<body>

  <h1>Kul Scientific Calculator</h1>

  <div class="calculator">

    <input
      type="text"
      id="display"
      readonly
    >

    <div class="buttons">

      <!-- Row 1 -->
      <button class="clear" onclick="clearDisplay()">AC</button>
      <button class="function" onclick="backspace()">⌫</button>
      <button class="function" onclick="percent()">%</button>
      <button class="operator" onclick="add('/')">÷</button>

      <!-- Row 2 -->
      <button class="function" onclick="squareRoot()">√</button>
      <button onclick="add('7')">7</button>
      <button onclick="add('8')">8</button>
      <button onclick="add('9')">9</button>

      <!-- Row 3 -->
      <button class="operator" onclick="add('*')">×</button>
      <button onclick="add('4')">4</button>
      <button onclick="add('5')">5</button>
      <button onclick="add('6')">6</button>

      <!-- Row 4 -->
      <button class="operator" onclick="add('-')">−</button>
      <button onclick="add('1')">1</button>
      <button onclick="add('2')">2</button>
      <button onclick="add('3')">3</button>

      <!-- Row 5 -->
      <button class="operator" onclick="add('+')">+</button>
      <button onclick="add('0')">0</button>
      <button onclick="add('.')">.</button>
      <button class="equal" onclick="calculate()">=</button>

      <!-- Row 6 -->
      <button class="function" onclick="plusMinus()">+/-</button>
      <button class="function" onclick="square()">x²</button>
      <button class="function" onclick="cube()">x³</button>
      <button class="function" onclick="reciprocal()">1/x</button>

    </div>

  </div>

  <script>

    function add(value) {
      document.getElementById("display").value += value;
    }

    function clearDisplay() {
      document.getElementById("display").value = "";
    }

    function backspace() {

      let display =
        document.getElementById("display");

      display.value =
        display.value.slice(0, -1);
    }

    function calculate() {

      let display =
        document.getElementById("display");

      try {

        if (display.value.trim() === "") {
          return;
        }

        display.value = eval(display.value);

      } catch {

        display.value = "Error";

      }
    }

    function percent() {

      let display =
        document.getElementById("display");

      try {

        display.value =
          eval(display.value) / 100;

      } catch {

        display.value = "Error";

      }
    }

    function squareRoot() {

      let display =
        document.getElementById("display");

      try {

        display.value =
          Math.sqrt(eval(display.value));

      } catch {

        display.value = "Error";

      }
    }

    function square() {

      let display =
        document.getElementById("display");

      try {

        display.value =
          Math.pow(eval(display.value), 2);

      } catch {

        display.value = "Error";

      }
    }

    function cube() {

      let display =
        document.getElementById("display");

      try {

        display.value =
          Math.pow(eval(display.value), 3);

      } catch {

        display.value = "Error";

      }
    }

    function reciprocal() {

      let display =
        document.getElementById("display");

      try {

        display.value =
          1 / eval(display.value);

      } catch {

        display.value = "Error";

      }
    }

    function plusMinus() {

      let display =
        document.getElementById("display");

      try {

        display.value =
          -eval(display.value);

      } catch {

        display.value = "Error";

      }
    }

  </script>

</body>
</html>
